# Server Environment Variables
# EduSankofa School Management System - Backend
# IMPORTANT: Copy this file to .env and fill in your actual values

# ─── DATABASE ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/edusankofa

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
TZ=Accra

# ─── JWT AUTHENTICATION ──────────────────────────────────────────────────────
# IMPORTANT: Generate a secure random secret before deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING

# ─── SECURITY ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_UPLOAD=10
ALLOWED_IPS=
DISABLE_LOGIN_RATE_LIMIT=false

# ─── FILE UPLOAD ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ─── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_VERSION=1.0.0
SERVER_ID=edusankofa-server-01

# ─── LICENSE ──────────────────────────────────────────────────────────────────
DEPLOYMENT_MODE=self-hosted
LICENSE_VALIDATION_INTERVAL=300000

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─── PAYSTACK ────────────────────────────────────────────────────────────────
# Get live keys from https://dashboard.paystack.com/#/settings/developer
# DO NOT use test keys (sk_test_/pk_test_) in production
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:3001/payment/callback

# ─── SMS (HUBTEL) ────────────────────────────────────────────────────────────
# Optional: required only if SMS notifications are enabled
HUBTEL_SMS_URL=https://sms.hubtel.com/api/v1/messages/send
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=
HUBTEL_SMS_TIMEOUT_MS=10000

# ─── WHATSAPP (META) ────────────────────────────────────────────────────────
# Optional: required only if WhatsApp notifications are enabled
META_GRAPH_API_VERSION=v18.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TIMEOUT_MS=10000

# ─── SEEDING ─────────────────────────────────────────────────────────────────
# Set to true only when running seed scripts in development
SEED_RESET_PASSWORDS=false
FEE_REMINDER_TEMPLATE=default
