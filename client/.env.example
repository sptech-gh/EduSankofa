# Client Environment Variables
# EduSankofa School Management System - Frontend
# IMPORTANT: Copy this file to .env and fill in your actual values

# Prevent ESLint warnings from blocking CI builds
CI=false

# API Configuration
REACT_APP_API_URL=http://localhost:5001/api

# App Identity
REACT_APP_APP_NAME=EduSankofa School Management

# Environment
NODE_ENV=development

# Feature Flags
REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_ANALYTICS=false

# License Configuration
REACT_APP_DEPLOYMENT_MODE=self-hosted
