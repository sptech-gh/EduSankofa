# Super Admin Server Environment Variables
# Central control server for license and subscription management
# IMPORTANT: Copy this file to .env and fill in your actual values

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=6000
NODE_ENV=development

# ─── DATABASE (Separate Central DB) ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/edusankofa-central

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=24h

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6001

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── SECURITY ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── LICENSE ──────────────────────────────────────────────────────────────────
LICENSE_KEY_LENGTH=32
GRACE_PERIOD_DAYS=7

# ─── MONITORING ──────────────────────────────────────────────────────────────
HEARTBEAT_TIMEOUT_MINUTES=10

# ─── PAYSTACK (Billing) ──────────────────────────────────────────────────────
# Get live keys from https://dashboard.paystack.com/#/settings/developer
# DO NOT use test keys in production
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_SUBACCOUNT_CODE=

# ─── APPLICATION URLS ────────────────────────────────────────────────────────
BASE_URL=http://localhost:6000
